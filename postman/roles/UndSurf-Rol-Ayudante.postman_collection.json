    {
      "name": "05. Listado de pozos (200, solo los suyos)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código 200\", function () { pm.expect(pm.response.code).to.eql(200); });",
              "const ids = (pm.response.json().data || []).map(function (h) { return String(h.id); });",
              "const mine = JSON.parse(pm.collectionVariables.get(\"r_my_hole_ids\") || \"[]\");",
              "pm.test(\"Solo pozos de su cuadrilla\", function () { ids.forEach(function (id) { pm.expect(mine).to.include(id); }); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{r_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/tenant/holes?limit=50",
          "host": [
            "{{base_url}}"
          ],
          "path": [
