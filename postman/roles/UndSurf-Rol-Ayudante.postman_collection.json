    {
      "name": "06. Ficha del pozo {{hole_id}} (200 si es suyo, 403 si no)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get(\"hole_id\")) { console.log(\"Se omite: el entorno no tiene hole_id.\"); pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const mine = JSON.parse(pm.collectionVariables.get(\"r_my_hole_ids\") || \"[]\");",
              "const propio = mine.indexOf(String(pm.environment.get(\"hole_id\"))) !== -1;",
              "pm.test(propio ? \"Es suyo: 200\" : \"No es suyo: 403\", function () { pm.expect(pm.response.code).to.eql(propio ? 200 : 403); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{r_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/tenant/holes/{{hole_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "tenant",
            "holes",
            "{{hole_id}}"
          ]
        }
      }
