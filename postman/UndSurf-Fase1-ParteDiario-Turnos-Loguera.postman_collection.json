  "item": [
    {
      "name": "00 Auth y Descubrimiento (Paso Inicial - Solo Admin)",
      "description": "Ejecutá esta carpeta primero usando tu usuario Admin existente (email_admin y password en el Environment).\n\nAl hacer Login Administrador, se autocompletan los tokens de los demás roles para que puedas hacer pruebas parciales del flujo completo sin esperar a crear otros usuarios.",
      "item": [
        {
          "name": "1. Login Administrador (email_admin + password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Codigo 200 OK\", () => pm.expect(pm.response.code).to.eql(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Retorna token Bearer\", () => pm.expect(json.token).to.be.a(\"string\").and.not.empty);",
                  "if (json.token) {",
                  "    pm.environment.set(\"token_admin\", json.token);",
                  "    pm.collectionVariables.set(\"token_admin\", json.token);",
                  "    // Modo pruebas parciales: permite ejecutar carpetas 01, 02 y 03 solo con Admin",
                  "    pm.environment.set(\"token_driller\", json.token);",
                  "    pm.environment.set(\"token_supervisor\", json.token);",
                  "    pm.environment.set(\"token_geologist\", json.token);",
                  "    pm.collectionVariables.set(\"token_driller\", json.token);",
                  "    pm.collectionVariables.set(\"token_supervisor\", json.token);",
                  "    pm.collectionVariables.set(\"token_geologist\", json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email_admin}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{base_url}}/auth/login",
            "description": "Inicia sesión con tu cuenta Admin de producción (variables email_admin y password) y habilita pruebas parciales automáticas."
          }
        },
        {
          "name": "2. Listar Pozos del Tenant (Auto-selecciona hole_id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Codigo 200 OK\", () => pm.expect(pm.response.code).to.eql(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Retorna lista de pozos\", () => pm.expect(json.data).to.be.an(\"array\"));",
                  "if (Array.isArray(json.data) && json.data.length > 0) {",
                  "    const operable = json.data.find(h => String(h.status || \"\").toLowerCase() === \"in_progress\") || json.data[0];",
                  "    const selectedId = String(operable.id);",
                  "    pm.environment.set(\"hole_id\", selectedId);",
                  "    pm.collectionVariables.set(\"hole_id\", selectedId);",
                  "    console.log(\"Pozo seleccionado:\", selectedId, \"status:\", operable.status);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": "{{base_url}}/tenant/holes",
            "description": "Consulta los pozos reales de tu organización en el servidor y guarda el primer hole_id operable."
          }
        },
        {
          "name": "3. Estado Actual del Pozo (Auto-calcula depth_from / depth_to)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Codigo 200 OK\", () => pm.expect(pm.response.code).to.eql(200));",
                  "const json = pm.response.json();",
                  "const summary = json.summary || {};",
                  "const current = summary.current_depth !== null && summary.current_depth !== undefined ? Number(summary.current_depth) : 0;",
                  "const nextFrom = Number(current.toFixed(2));",
                  "const nextTo = Number((current + 3).toFixed(2));",
                  "pm.environment.set(\"next_depth_from\", String(nextFrom));",
                  "pm.environment.set(\"next_depth_to\", String(nextTo));",
                  "pm.collectionVariables.set(\"next_depth_from\", String(nextFrom));",
                  "pm.collectionVariables.set(\"next_depth_to\", String(nextTo));",
                  "console.log(\"Cota preparada -> depth_from:\", nextFrom, \"depth_to:\", nextTo, \"depth_initialized:\", summary.depth_initialized);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": "{{base_url}}/tenant/holes/{{hole_id}}/progress",
            "description": "Lee la profundidad actual del pozo elegido y calcula automáticamente next_depth_from y next_depth_to para no chocar con cotas existentes."
          }
        },
        {
          "name": "4. (Solo si es nuevo) Inicializar Profundidad Base",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Inicializado (200) o ya poseia partes (422)\", () => {",
                  "    pm.expect([200, 422]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"initial_depth\": {{next_depth_from}},\n  \"notes\": \"Inicialización operativa desde Postman\"\n}"
            },
            "url": "{{base_url}}/tenant/holes/{{hole_id}}/initialize-depth",
            "description": "Ejecutar solo si el pozo aún no tiene depth_initialized = true y el Gateway no devolvió reached_depth."
          }
        }
      ]
    },
