    {
      "name": "01 Perforista (Parte Diario y Turnos)",
      "item": [
        {
          "name": "Registrar Parte Diario (depth_from, depth_to, hours_worked)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const key = \"pm-prog-\" + Date.now() + \"-\" + Math.floor(Math.random() * 100000);",
                  "pm.variables.set(\"idem_key\", key);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Codigo 201 Created\", () => pm.expect(pm.response.code).to.eql(201));",
                  "const json = pm.response.json();",
                  "pm.test(\"Estado inicial es pending_review\", () => {",
                  "    pm.expect(json.data.status).to.eql(\"pending_review\");",
                  "});",
                  "pm.test(\"Registra horas trabajadas\", () => {",
                  "    pm.expect(Number(json.data.hours_worked)).to.eql(8);",
                  "});",
                  "if (json.data && json.data.id) {",
                  "    pm.environment.set(\"progress_log_id\", String(json.data.id));",
                  "    pm.collectionVariables.set(\"progress_log_id\", String(json.data.id));",
                  "    const nextFrom = Number(json.data.depth_to);",
                  "    const nextTo = Number((nextFrom + 3).toFixed(2));",
                  "    pm.environment.set(\"next_depth_from\", String(nextFrom));",
                  "    pm.environment.set(\"next_depth_to\", String(nextTo));",
                  "    pm.collectionVariables.set(\"next_depth_from\", String(nextFrom));",
                  "    pm.collectionVariables.set(\"next_depth_to\", String(nextTo));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_driller}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"depth_from\": {{next_depth_from}},\n  \"depth_to\": {{next_depth_to}},\n  \"hours_worked\": 8,\n  \"shift\": \"Turno 1\",\n  \"logged_at\": \"2026-11-11 10:00:00\",\n  \"idempotency_key\": \"{{idem_key}}\"\n}"
            },
            "url": "{{base_url}}/tenant/holes/{{hole_id}}/progress"
          }
        },
        {
          "name": "Validacion: Exceso de 8 hs por turno (Falla 422)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const key = \"pm-prog-\" + Date.now() + \"-\" + Math.floor(Math.random() * 100000);",
                  "pm.variables.set(\"idem_key\", key);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
