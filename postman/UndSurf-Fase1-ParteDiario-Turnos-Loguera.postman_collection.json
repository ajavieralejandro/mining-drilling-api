    {
      "name": "01 Perforista (Parte Diario y Turnos)",
      "item": [
        {
          "name": "Registrar Parte Diario (depth_from, depth_to, hours_worked)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Codigo 201 Created\", () => pm.expect(pm.response.code).to.eql(201));",
                  "const json = pm.response.json();",
                  "pm.test(\"Estado inicial es pending_review\", () => {",
                  "    pm.expect(json.data.status).to.eql(\"pending_review\");",
                  "});",
                  "pm.test(\"Registra horas trabajadas\", () => {",
                  "    pm.expect(Number(json.data.hours_worked)).to.eql(8);",
                  "});",
                  "if (json.data && json.data.id) {",
                  "    pm.environment.set(\"progress_log_id\", String(json.data.id));",
                  "    pm.collectionVariables.set(\"progress_log_id\", String(json.data.id));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_driller}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"depth_from\": 0,\n  \"depth_to\": 3,\n  \"hours_worked\": 8,\n  \"logged_at\": \"2026-11-10 10:00:00\"\n}"
            },
            "url": "{{base_url}}/tenant/holes/{{hole_id}}/progress"
          }
        },
        {
          "name": "Validacion: Exceso de 8 hs por turno (Falla 422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Codigo 422 Unprocessable Entity\", () => pm.expect(pm.response.code).to.eql(422));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_driller}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"depth_from\": 3,\n  \"depth_to\": 6,\n  \"hours_worked\": 9,\n  \"logged_at\": \"2026-11-10 12:00:00\"\n}"
            },
            "url": "{{base_url}}/tenant/holes/{{hole_id}}/progress"
          }
        },
        {
          "name": "Validacion: Ventana de Voladuras (00:00 - 08:00) (Falla 422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Codigo 422 Unprocessable Entity\", () => pm.expect(pm.response.code).to.eql(422));",
                  "const json = pm.response.json();",
                  "pm.test(\"Mensaje explicito de voladura\", () => {",
                  "    pm.expect(JSON.stringify(json.errors)).to.include(\"voladuras\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_driller}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"depth_from\": 3,\n  \"depth_to\": 5,\n  \"hours_worked\": 4,\n  \"logged_at\": \"2026-11-10 03:30:00\"\n}"
            },
            "url": "{{base_url}}/tenant/holes/{{hole_id}}/progress"
          }
        }
      ]
    },
