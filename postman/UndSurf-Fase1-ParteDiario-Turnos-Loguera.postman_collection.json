    { "key": "base_url", "value": "http://127.0.0.1:8000/api" },
    { "key": "token_driller", "value": "" },
    { "key": "token_supervisor", "value": "" },
    { "key": "token_geologist", "value": "" },
    { "key": "token_admin", "value": "" },
    { "key": "hole_id", "value": "1001" },
    { "key": "progress_log_id", "value": "" }
