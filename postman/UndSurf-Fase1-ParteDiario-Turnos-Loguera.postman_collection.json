    {
      "name": "01 Perforista (Parte Diario & Validaciones Mineras)",
      "item": [
        {
          "name": "POST Registrar Parte Diario (Datos Básicos: from, to, hours_worked)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Código 200 o 201', () => {",
                  "    pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "pm.test('Queda en estado pending_review', () => {",
                  "    pm.expect(json.data.status).to.eql('pending_review');",
                  "});",
                  "pm.test('Registra horas trabajadas', () => {",
                  "    pm.expect(json.data.hours_worked).to.eql('7.50');",
                  "});",
                  "if (json.data && json.data.id) {",
                  "    pm.collectionVariables.set('progress_log_id', json.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_driller}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"depth_from\": 0.0,\n  \"depth_to\": 4.5,\n  \"hours_worked\": 7.5,\n  \"shift\": \"Turno 1\",\n  \"idempotency_key\": \"idem-{{$timestamp}}-1\",\n  \"logged_at\": \"2026-11-10T12:00:00Z\",\n  \"observations\": \"Turno 1: perforación normal sin desviaciones.\"\n}"
            },
            "url": "{{base_url}}/tenant/holes/{{hole_id}}/progress"
          }
        },
        {
          "name": "POST Validación: Exceso de 8 hs por turno (Falla 422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rechazo 422 por superar 8 hs de turno minero', () => {",
                  "    pm.expect(pm.response.code).to.eql(422);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Mensaje de error en hours_worked', () => {",
                  "    pm.expect(json.errors.hours_worked).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_driller}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"depth_from\": 4.5,\n  \"depth_to\": 10.0,\n  \"hours_worked\": 10.0,\n  \"shift\": \"Turno 1\",\n  \"idempotency_key\": \"idem-{{$timestamp}}-exceed\",\n  \"logged_at\": \"2026-11-10T14:00:00Z\"\n}"
            },
            "url": "{{base_url}}/tenant/holes/{{hole_id}}/progress"
          }
        },
        {
          "name": "POST Validación: Ventana de Voladuras y Ventilación (00:00 - 08:00) (Falla 422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rechazo 422 por horario de voladura/ventilación', () => {",
                  "    pm.expect(pm.response.code).to.eql(422);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Error menciona ventana de voladura', () => {",
                  "    pm.expect(json.errors.logged_at[0]).to.include('voladura y ventilación');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_driller}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"depth_from\": 4.5,\n  \"depth_to\": 8.0,\n  \"hours_worked\": 6.0,\n  \"shift\": \"Turno 2\",\n  \"idempotency_key\": \"idem-{{$timestamp}}-blast\",\n  \"logged_at\": \"2026-11-10T03:30:00Z\"\n}"
            },
            "url": "{{base_url}}/tenant/holes/{{hole_id}}/progress"
          }
        }
      ]
