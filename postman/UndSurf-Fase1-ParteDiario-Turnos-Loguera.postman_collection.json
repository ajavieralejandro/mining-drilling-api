    {
      "name": "03 Geólogo (Loguera de Testigos & RQD)",
      "item": [
        {
          "name": "POST Asentar Corrida en Loguera (Cálculo RQD Automático)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 201 Created', () => {",
                  "    pm.expect(pm.response.code).to.eql(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Largo perforado calculado (run_to - run_from = 3.00 m)', () => {",
                  "    pm.expect(json.data.drill_length).to.eql('3.00');",
                  "});",
                  "pm.test('RQD calculado correctamente ((2.10 / 3.00) * 100 = 70.00%)', () => {",
                  "    pm.expect(json.data.rqd_percentage).to.eql('70.00');",
                  "});",
                  "pm.test('Pérdida de testigo calculada (3.00 - 2.70 = 0.30 m)', () => {",
                  "    pm.expect(json.data.core_loss_meters).to.eql('0.30');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_geologist}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"run_from\": 0.0,\n  \"run_to\": 3.0,\n  \"recovered_meters\": 2.7,\n  \"rqd_meters\": 2.1,\n  \"box_number\": \"CAJA-01\",\n  \"logged_at\": \"2026-11-10T15:00:00Z\",\n  \"geology_notes\": \"Testigo recuperado en loguera con litología dacítica.\"\n}"
            },
            "url": "{{base_url}}/tenant/holes/{{hole_id}}/core-logs"
          }
