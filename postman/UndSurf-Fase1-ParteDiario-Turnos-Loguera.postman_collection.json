        {
          "name": "POST Aprobar Parte Diario",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200 OK', () => {",
                  "    pm.expect(pm.response.code).to.eql(200);",
