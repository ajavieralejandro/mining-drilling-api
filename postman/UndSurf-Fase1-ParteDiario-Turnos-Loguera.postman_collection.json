    {
      "name": "00 Auth (Logins por Rol)",
      "item": [
        {
          "name": "Login Perforista",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Codigo 200 OK\", () => pm.expect(pm.response.code).to.eql(200));",
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.environment.set(\"token_driller\", json.token);",
                  "    pm.collectionVariables.set(\"token_driller\", json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email_driller}}\",\n  \"password\": \"{{password_driller}}\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          }
