    {
      "name": "01 Catálogo de Permisos Granulares",
      "description": "Verifica la consulta del catálogo de permisos agrupados por módulo y la protección 403.",
      "item": [
        {
          "name": "1. Listar Catálogo de Permisos (Admin - 200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Codigo 200 OK\", function () { pm.expect(pm.response.code).to.eql(200); });",
                  "const json = pm.response.json();",
                  "pm.test(\"Contiene modulos y permisos\", function () {",
                  "    pm.expect(json.data).to.be.an(\"array\");",
                  "    pm.expect(json.modules).to.be.an(\"object\");",
                  "    pm.expect(json.total >= 1).to.eql(true);",
                  "});",
                  "const pView = (json.data || []).find(p => p.name === 'projects.view');",
                  "const mMng = (json.data || []).find(p => p.name === 'mines.manage');",
                  "const rView = (json.data || []).find(p => p.name === 'roles.view');",
                  "if (pView) pm.collectionVariables.set(\"perm_projects_view_id\", String(pView.id));",
                  "if (mMng) pm.collectionVariables.set(\"perm_mines_manage_id\", String(mMng.id));",
                  "if (rView) pm.collectionVariables.set(\"perm_roles_view_id\", String(rView.id));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/tenant/permissions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tenant",
                "permissions"
              ]
            }
          }
        },
        {
          "name": "2. Perforista intenta consultar permisos (403 Forbidden)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Codigo 403 Forbidden\", function () { pm.expect(pm.response.code).to.eql(403); });",
                  "const json = pm.response.json();",
                  "pm.test(\"Error estructurado\", function () {",
                  "    pm.expect(json.error).to.be.an(\"object\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_driller}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/tenant/permissions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tenant",
                "permissions"
              ]
            }
          }
        }
      ]
    },
