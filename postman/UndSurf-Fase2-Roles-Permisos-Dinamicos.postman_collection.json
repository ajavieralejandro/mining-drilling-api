  "item": [
    {
      "name": "00 Autenticación Inicial",
      "description": "Obtiene los tokens Bearer para el Administrador y para un Perforista para contrastar permisos RBAC.",
      "item": [
        {
          "name": "1. Login Administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Codigo 200 OK\", function () { pm.expect(pm.response.code).to.eql(200); });",
                  "const json = pm.response.json();",
                  "pm.test(\"Retorna token Bearer\", function () { pm.expect(json.token).to.be.a(\"string\"); });",
                  "if (json.token) {",
                  "    pm.collectionVariables.set(\"token_admin\", json.token);",
                  "    if (pm.environment) pm.environment.set(\"token_admin\", json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email_admin}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
