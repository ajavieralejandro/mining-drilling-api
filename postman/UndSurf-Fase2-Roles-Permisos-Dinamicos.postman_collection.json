    {
      "name": "06 Asignación de Rol Custom a Personal y Verificación de Permisos",
      "description": "Registra un usuario asignándole el rol custom creado y valida que sus permisos efectivos correspondan al nuevo rol.",
      "item": [
        {
          "name": "1. Admin registra personal con el Rol Custom (201 Created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Codigo 201 Created\", function () { pm.expect(pm.response.code).to.eql(201); });",
                  "const json = pm.response.json();",
                  "pm.test(\"Retorna integrante con rol custom\", function () {",
                  "    pm.expect(json.data.role).to.eql(pm.collectionVariables.get(\"custom_role_slug\"));",
                  "});",
                  "if (json.temporary_password) {",
                  "    pm.collectionVariables.set(\"custom_user_password\", json.temporary_password);",
                  "}",
                  "if (json.data && json.data.id) {",
                  "    pm.collectionVariables.set(\"custom_user_id\", String(json.data.id));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
